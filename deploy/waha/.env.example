# Copy to .env and replace every value before starting WAHA.
WAHA_API_KEY=replace-with-a-long-random-value
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-different-long-random-value
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-third-long-random-value
WHATSAPP_DEFAULT_ENGINE=NOWEB
# Complete locally with the alternative sender (country code included).
# Never use the number ending in 8226.
PETOS_WAHA_PHONE=
